include "variable.fbs";

namespace weidmueller.ucontrol.hub;

/// A definition of a provider's provided variables.
///
/// Definition elements have a flat list instead of a hierarchy structure.
/// They support the folder concept as a means of grouping definitions by using
/// a shared name prefix for the grouped definitions.
/// This means that the grouped definitions have names that begin with a common
/// string.
/// This common string, or shared prefix, is the folder name.
///
/// For security reasons, the provider name must be extracted from the
/// communication channel.
table ProviderDefinition {
  /// The fingerprint of the definition as means of linking to variable values.
  fingerprint: uint64;
  /// The list of variable definitions.
  variable_definitions: [VariableDefinition];
}
