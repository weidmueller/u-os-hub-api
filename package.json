{
  "name": "u-os-hub-api",
  "version": "1.0.0-next",
  "description": "u-os-hub-api contains the API specifications for the u-OS Data Hub.",
  "keywords": [
    "u-OS Data Hub",
    "OpenAPI spec",
    "AsyncAPI spec"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/weidmueller/u-os-hub-api"
  },
  "homepage": "https://www.weidmueller.de/de/loesungen/technologien/edge_computing_u_os/index.jsp",
  "license": "MIT",
  "scripts": {
    "build": "npm run generateJsonSchemas && npm run validateAsyncApi && npm run generateAsyncApiSite && npm run validateOpenApi",
    "generateJsonSchemas": "./tools/generate_json_schemas.sh",
    "generateAsyncApiSite": "asyncapi generate fromTemplate variable-nats-asyncapi.yaml @asyncapi/html-template@0.28.4 -o ./dist/asyncapi --force-write -p sidebarOrganization=byTags",
    "validateOpenApi": "spectral lint --fail-severity=warn variable-http-openapi.yaml --ruleset ./tools/spectral.json",
    "validateAsyncApi": "spectral lint --fail-severity=warn variable-nats-asyncapi.yaml --ruleset ./tools/spectral.json"
  },
  "devDependencies": {
    "@asyncapi/cli": "^3",
    "@stoplight/spectral-cli": "^6",
    "@stoplight/spectral-owasp-ruleset": "^2"
  }
}
