{
  "scripts": {
    "build": "npm run generateJsonSchemas && npm run validateAsyncApi && npm run generateAsyncApi && npm run validateOpenApi && npm run buildUi",
    "buildUi": "./tools/generate_swagger_ui.sh",
    "generateJsonSchemas": "./tools/generate_json_schemas.sh",
    "generateAsyncApi": "asyncapi generate fromTemplate asyncapi.yaml @asyncapi/html-template@0.28.4 -o ./dist/asyncapi --force-write -p sidebarOrganization=byTags",
    "validateOpenApi": "spectral lint --fail-severity=warn openapi.yaml --ruleset ./tools/spectral.json",
    "validateAsyncApi": "asyncapi validate --fail-severity=warn asyncapi.yaml"
  },
  "dependencies": {
    "swagger-ui-dist": "^5"
  },
  "devDependencies": {
    "@asyncapi/cli": "^0.8.1",
    "@stoplight/spectral-cli": "^6",
    "@stoplight/spectral-owasp-ruleset": "^2.0.1"
  }
}
