  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Mock HTTP API",
      "killBehavior": "polite",
      "skipFiles": ["<node_internals>/**"],
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run-script", "start:debug"],
      "cwd": "${workspaceFolder}/mock-http-api",
      "outputCapture": "std"
    }
  ]
}
