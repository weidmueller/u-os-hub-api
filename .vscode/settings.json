{
    "cSpell": {
        "language": "en-GB",
        "words": []
    },
    "editor": {
        "wordWrapColumn": 79,
        "wordWrap": "bounded",
        "rulers": [
            79
        ]
    },
    "liveServer": {
        "settings": {
            "root": "/dist"
        }
    },
    "runOnSave": {
        "commands": [
            {
                "async": false,
                "command": "npm run build && echo 'Site generation complete!'",
                "finishStatusMessage": "Site generation complete!",
                "match": ".*",
                "notMatch": "(dist|node_modules|.git)",
                "runIn": "backend",
                "runningStatusMessage": "Generating site..."
            }
        ]
    }
}